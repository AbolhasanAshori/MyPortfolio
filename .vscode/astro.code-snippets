{
  "barrel-export-ts": {
    "prefix": "bxp",
    "scope": "typescript",
    "body": [
      "export type { ${1:ComponentName}Props } from \"./${1:ComponentName}.astro\";",
      "export { default as ${1:ComponentName} } from \"./${1:ComponentName}.astro\";\n\n$0",
    ],
    "description": "Component Barrel Export"
  },
  "barrel-export-js": {
    "prefix": "bxp",
    "scope": "javascript",
    "body": "export { default as ${1:ComponentName} } from \"./${1:ComponentName}.astro\";\n\n$0",
    "description": "Component Barrel Export"
  },
  "barrel-export": {
    "prefix": "bx",
    "scope": "javascript,typescript",
    "body": "export * from \"./${1:componentName}\";\n$0",
    "description": "Barrel Export"
  }
}