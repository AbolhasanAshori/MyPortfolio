---
import MenuIcon from "@/assets/icons/menu.svg";
import Logo from "@/assets/logo.svg";
import { ColorSwitch } from "../ColorSwitch";
import { ResumeButton } from "../Resume";
---

<header class="fixed top-0 left-0 right-0 flex justify-center py-6 px-4 md:px-6 lg:px-8 xl:px-12 2xl:px-16 lg:py-4">
  <div
    class="bg-dark-surface-container-lowest dark:bg-surface-container-lowest flex justify-between items-center p-2 rounded-2xl w-full lg:max-w-[762px] xl:max-w-[1060px] 2xl:max-w-[1080px]"
  >
    <div class="ms-2 basis-1/2 flex lg:hidden">
      <button class="menu-btn">
        <MenuIcon class="stroke-white dark:stroke-black" height="32" width="32" />
      </button>
    </div>
    <div style="height: 36px; width: 36px;">
      <Logo class="fill-white dark:fill-black w-full h-full p-1 sm:p-0,5" />
    </div>
    <div class="flex gap-4 basis-1/2 justify-end">
      <ColorSwitch class="-me-2 hidden lg:flex" />
      <ResumeButton />
    </div>
  </div>
</header>

<script>
  import { menuOpen } from "@/store";
  const menuBtn = document.querySelector(".menu-btn") as HTMLButtonElement;

  menuBtn.addEventListener("click", () => {
    menuOpen.set(!menuOpen.get());
  });
</script>
