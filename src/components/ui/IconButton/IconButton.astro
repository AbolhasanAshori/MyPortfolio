---
import type { MdIconButton } from "@material/web/iconbutton/icon-button";
import type { LitElementProps } from "@/types";

interface Props extends LitElementProps<MdIconButton> {}

const props = Astro.props;
---

<md-icon-button {...props}>
  <slot />
  <slot name="selected" />
</md-icon-button>

<script>
  import "@material/web/iconbutton/icon-button.js";
</script>

<style>
  md-icon-button {
    --md-sys-shape-corner-full: var(--icon-button-radius, unset);
    --md-sys-color-on-surface: var(--icon-button-disabled-color, unset);
    --md-sys-color-on-surface-variant: var(--icon-button-color, unset);
    --md-sys-color-primary: var(--icon-button-selected-color, unset);
    --md-icon-button-state-layer-height: var(--icon-button-height, unset);
    --md-icon-button-state-layer-width: var(--icon-button-width, unset);
    --md-icon-button-icon-size: var(--icon-button-size, unset);
  }

