---
import type { MdFilledButton } from "@material/web/button/filled-button";
import type { LitElementProps } from "@/types";
import type { ButtonConfigurations } from "./config";

interface Props extends LitElementProps<MdFilledButton>, ButtonConfigurations {}

const { shape = "round", size = "sm", ...otherProps } = Astro.props;
---

<md-filled-button shape={shape} size={size} {...otherProps}>
  <slot />
  <slot name="icon" />
</md-filled-button>

<script>
  import "@material/web/button/filled-button.js";
</script>

<style>
  md-filled-button {
    --md-sys-color-on-surface: var(--filled-button-disabled-color, unset);
    --md-sys-color-primary: var(--filled-button-selected-color, unset);
    --md-sys-color-on-primary: var(--filled-button-color, unset);
  }

  /*
    TODO: Add responsive sizing based on design tokens
    https://m3.material.io/components/buttons/specs  
  */
  /* Custom styling for square configuration */
  md-filled-button[shape="square"] {
    --md-filled-button-container-shape: var(--md-sys-shape-corner-medium, 12px);
  }

  /* Base Material button styles */
  md-filled-button {
    padding-block: calc((var(--_container-height) - $single-line-height) / 2);
    padding-inline-start: var(--_leading-space);
    padding-inline-end: var(--_trailing-space);
  }

  md-filled-button[has-icon]:not([trailing-icon]) {
    padding-inline-start: var(--_with-leading-icon-leading-space);
    padding-inline-end: var(--_with-leading-icon-trailing-space);
  }

  md-filled-button[has-icon][trailing-icon] {
    padding-inline-start: var(--_with-trailing-icon-leading-space);
    padding-inline-end: var(--_with-trailing-icon-trailing-space);
  }

